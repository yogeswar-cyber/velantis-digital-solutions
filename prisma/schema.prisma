// VELANTIS DIGITAL SOLUTIONS — Prisma Database Schema
// Optimized for SQLite in local development and PostgreSQL in production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String                 @id @default(cuid())
  email         String                 @unique
  passwordHash  String
  name          String
  role          String                 @default("ADMIN") // ADMIN, STAFF
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  lastLoginAt   DateTime?
  auditLogs     AuditLog[]
  statusHistory ProjectStatusHistory[]

  @@map("users")
}

model Service {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String
  icon         String    // Lucide icon identifier (e.g. Code2, ShoppingCart)
  active       Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  features     Feature[]
  projects     Project[]

  @@map("services")
}

model Feature {
  id              String           @id @default(cuid())
  serviceId       String
  service         Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  category        String?
  active          Boolean          @default(true)
  displayOrder    Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  projectFeatures ProjectFeature[]

  @@map("features")
}

model Project {
  id              String                 @id @default(cuid())
  referenceNumber String                 @unique // Format: VL-YYYY-XXXX (e.g. VL-2026-0001)
  clientName      String
  clientEmail     String
  clientPhone     String?
  companyName     String?
  serviceId       String?
  service         Service?               @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  budgetRange     String?
  timeline        String?
  description     String
  status          String                 @default("NEW") // NEW, REVIEWING, CONTACTED, QUOTED, APPROVED, IN_PROGRESS, COMPLETED, CANCELLED
  internalNotes   String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  features        ProjectFeature[]
  files           ProjectFile[]
  statusHistory   ProjectStatusHistory[]

  @@map("projects")
}

model ProjectFeature {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  featureId         String?
  feature           Feature? @relation(fields: [featureId], references: [id], onDelete: SetNull)
  customFeatureName String?  // Optional client-defined feature
  createdAt         DateTime @default(now())

  @@map("project_features")
}

model ProjectFile {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalFilename String
  storedFilename   String
  mimeType         String
  size             Int      // File size in bytes
  storageKey       String   @unique
  createdAt        DateTime @default(now())

  @@map("project_files")
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  subject     String
  projectType String?
  message     String
  status      String   @default("NEW") // NEW, READ, REPLIED, ARCHIVED
  ipAddress   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contact_messages")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String   // ADMIN_LOGIN, PROJECT_CREATED, PROJECT_STATUS_CHANGED, FILE_ACCESSED, etc.
  resourceType String   // PROJECT, MESSAGE, FILE, AUTH, SERVICE
  resourceId   String?
  metadata     String?  // Sanitized JSON string of event metadata
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@map("audit_logs")
}

model ProjectStatusHistory {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  oldStatus       String
  newStatus       String
  changedByUserId String?
  changedByUser   User?    @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime @default(now())

  @@map("project_status_history")
}

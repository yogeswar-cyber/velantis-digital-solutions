# =================================================================
# VELANTIS DIGITAL SOLUTIONS — Production Environment Variables
# =================================================================
# Copy to .env.production on the production host and configure secrets.
# NEVER commit real production secret keys to version control.

# Server Configuration
NODE_ENV=production
PORT=5000
CLIENT_URL=https://velantis.in

# Production Database (PostgreSQL)
# Examples: Supabase, Railway, Neon, AWS RDS
DATABASE_URL="postgresql://velantis_admin:SECURE_DB_PASSWORD@db.example.com:5432/velantis_db?schema=public&sslmode=prefer"

# Session & JWT Secrets (Generate with: openssl rand -base64 64)
SESSION_SECRET=GENERATE_A_SECURE_64_CHAR_RANDOM_STRING_FOR_SESSION
JWT_SECRET=GENERATE_A_SECURE_64_CHAR_RANDOM_STRING_FOR_JWT
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (Used by prisma/seed.js)
ADMIN_DEFAULT_EMAIL=admin@velantis.in
ADMIN_DEFAULT_PASSWORD=ChangeThisImmediatelyAfterFirstLogin123!

# Storage & Upload Limits
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Production SMTP Email Delivery
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_OR_MAILGUN_API_KEY
EMAIL_FROM="VELANTIS Digital Solutions <hello@velantis.in>"
TEAM_NOTIFICATION_EMAIL=team@velantis.in

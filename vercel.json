{
  "version": 2,
  "alias": [
    "velantis-digital-solutions.vercel.app",
    "velantis-digital-solutions-sigmaa.vercel.app"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}